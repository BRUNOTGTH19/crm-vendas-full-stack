# ==============================================================
# CRM Vendas API - Exemplo de variáveis de ambiente
# Copie para um arquivo ".env" e preencha com valores reais.
# (o arquivo .env NÃO deve ser versionado)
# ==============================================================

# Conexão com o MySQL (Clever Cloud em produção)
# Formato: mysql+pymysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# Conexão com o Redis (Upstash em produção — começa com rediss:// para TLS)
REDIS_URL=rediss://default:password@host:port

# Chave secreta para assinar os tokens JWT.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here

# Ambiente: "development" ou "production"
ENVIRONMENT=production

# --- Opcional (cobrança no WhatsApp) ---
# Nome exibido no rodapé da mensagem de cobrança.
# COMPANY_NAME="Minha Loja"
# Template da mensagem de cobrança. Placeholders: {cliente}, {venda},
# {valor}, {vencimento}, {situacao}, {empresa}
# COLLECTION_MESSAGE_TEMPLATE="Olá {cliente}! ... {valor} ... {vencimento} ..."