# ==============================================================
# CRM Vendas API - Exemplo de variáveis de ambiente
# Copie para um arquivo ".env" e preencha com valores reais.
# (o arquivo .env NÃO deve ser versionado)
# ==============================================================

# Conexão com o MySQL (Clever Cloud em produção)
# Formato: mysql+pymysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql+pymysql://user:password@host:port/dbname

# Conexão com o Redis (Upstash em produção — começa com rediss:// para TLS)
REDIS_URL=rediss://default:password@host:port

# Chave secreta para assinar os tokens JWT.
# Gerar com: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=your-secret-key-here

# Ambiente: "development" ou "production"
ENVIRONMENT=production

# Reset de dados via painel admin (POST /admin/database/reset).
# Opt-out: ligado por padrão. Defina "false" para desabilitar a ação.
ALLOW_DATABASE_RESET=true

# Origens permitidas no CORS, separadas por vírgula.
# "*" libera todas (app público com token Bearer, sem cookies).
# Para restringir: CORS_ALLOW_ORIGINS=https://seu-front.vercel.app
CORS_ALLOW_ORIGINS=*

# --- Web Push (notificações de alerta de prazo de vendas) ---
# Gere o par de chaves com: python gen_vapid_keys.py
# A pública também é usada pelo frontend (applicationServerKey).
VAPID_PUBLIC_KEY=your-vapid-public-key-base64url
VAPID_PRIVATE_KEY=your-vapid-private-key-base64url
VAPID_SUBJECT=mailto:admin@crm-vendas.com

# Lembretes: diariamente às 08:00 UTC (05:00 em São Paulo).
# Para 08:00 de Brasília: REMINDER_TIMEZONE=America/Sao_Paulo.
# 0 = hoje e atrasadas; 1 = inclui amanhã. Reinicie após alterar.
REMINDER_TIMEZONE=UTC
REMINDER_HOUR=8
REMINDER_DAYS_BEFORE=0


# --- Opcional (cobrança no WhatsApp) ---
# Nome exibido no rodapé da mensagem de cobrança.
# COMPANY_NAME="Minha Loja"
# Template da mensagem de cobrança. Placeholders: {cliente}, {venda},
# {valor}, {vencimento}, {situacao}, {empresa}
# COLLECTION_MESSAGE_TEMPLATE="Olá {cliente}! ... {valor} ... {vencimento} ..."

# --- Assistente de IA (opcional) ---
# Provedor com API OpenAI-compatível (Groq ou Google Gemini).
# AI_API_URL deve ser a URL COMPLETA do endpoint de chat/completions.
# A chave fica APENAS no backend (Render > Environment), nunca no frontend.
AI_API_URL=https://seu-provedor.example/v1/chat/completions
AI_API_KEY=troque-pela-chave-do-provedor
AI_MODEL=modelo-disponivel-no-provedor

# Busca na web (opcional). Sem chave, o assistente usa o fallback gratuito
# DuckDuckGo HTML. Com TAVILY_API_KEY, usa a API da Tavily (mais estável).
# Obtenha uma chave em https://tavily.com
# TAVILY_API_KEY=tvly-sua-chave